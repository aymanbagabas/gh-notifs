{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#e6edf3",
    "background_color": "#0d1117",
    "margin": 2
  },
  "block_quote": {
    "color": "#9198a1",
    "background_color": "#161b22",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#76d8d8",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#58a6ff",
    "background_color": "#163356",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#76d8d8"
  },
  "h3": {
    "prefix": "### ",
    "color": "#bc8cff"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#e6edf3"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#9198a1"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#9198a1",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "color": "#9198a1",
    "crossed_out": true
  },
  "emph": {
    "color": "#bc8cff",
    "italic": true
  },
  "strong": {
    "color": "#76d8d8",
    "bold": true
  },
  "hr": {
    "color": "#3d444d",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#58a6ff",
    "underline": true
  },
  "link_text": {
    "color": "#58a6ff",
    "bold": true
  },
  "image": {
    "color": "#58a6ff",
    "underline": true
  },
  "image_text": {
    "color": "#9198a1",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#bc8cff",
    "background_color": "#161b22"
  },
  "code_block": {
    "color": "#e6edf3",
    "background_color": "#161b22",
    "margin": 2,
    "theme": "github-dark"
  },
  "table": {
    "background_color": "#161b22",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#76d8d8",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
