{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#1f2328",
    "background_color": "#ffffff",
    "margin": 2
  },
  "block_quote": {
    "color": "#59636e",
    "background_color": "#f6f8fa",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#0e7490",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#0969da",
    "background_color": "#ddf4ff",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#0e7490"
  },
  "h3": {
    "prefix": "### ",
    "color": "#8250df"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#1f2328"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#59636e"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#59636e",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "color": "#59636e",
    "crossed_out": true
  },
  "emph": {
    "color": "#8250df",
    "italic": true
  },
  "strong": {
    "color": "#0e7490",
    "bold": true
  },
  "hr": {
    "color": "#d1d9e0",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#0969da",
    "underline": true
  },
  "link_text": {
    "color": "#0969da",
    "bold": true
  },
  "image": {
    "color": "#0969da",
    "underline": true
  },
  "image_text": {
    "color": "#59636e",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#8250df",
    "background_color": "#f6f8fa"
  },
  "code_block": {
    "color": "#1f2328",
    "background_color": "#f6f8fa",
    "margin": 2,
    "theme": "github"
  },
  "table": {
    "background_color": "#f6f8fa",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#0e7490",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
